const encoded = $node["Get a file1"].json["content"];
const currentRSS = Buffer.from(encoded, 'base64').toString('utf8');
const audioUrl = $node["Upload file1"].json["webViewLink"];
const title = $node["Update record1"].json["title"] || "New Mastermind Episode";
const summary = $node["Update record1"].json["summary"] || "Deep dive into success philosophy.";

const newEpisode = `<item>
  <title>${title}</title>
  <itunes:author>SoulCaptain</itunes:author>
  <description>${summary}</description>
  <pubDate>${new Date().toUTCString()}</pubDate>
  <enclosure url="${audioUrl}" length="0" type="audio/mpeg"/>
  <guid isPermaLink="false">${Math.random().toString(36).substring(7)}</guid>
  <itunes:duration>00:15:00</itunes:duration>
  <itunes:explicit>no</itunes:explicit>
</item>`;

const placeholder = /<!--\s*NEW_EPISODES_HERE\s*-->/;
const updatedRSS = currentRSS.replace(placeholder, newEpisode + '\n    <!-- NEW_EPISODES_HERE -->');
const encodedRSS = Buffer.from(updatedRSS).toString('base64');

return [{ json: { updatedRSS, encodedRSS } }];
